{
  "name": "dsh-fairy-voice",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "ref"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "Fairy 语音朗读",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shikelimiao/fairy-hdd-plugin.git",
    "directory": "packages/voice"
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
