{
  "name": "dsh-fairy-voice",
  "version": "1.0.3",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "server.mjs",
    "cordis.patch.yml",
    "ref",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "Fairy 语音朗读（自包含：自动拉起 9890 配置服务与语音引擎，缺失时回退系统语音）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shikelimiao/fairy-hdd-plugin.git",
    "directory": "packages/voice"
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
